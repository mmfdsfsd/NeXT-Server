{
  "domainStrategy": "IPOnDemand",
  "rules": [
    {
      "type": "field",
      "outboundTag": "block",
      "ip": [
        "geoip:private"
      ]
    },
    {
      "type": "field",
      "outboundTag": "block",
      "protocol": [
        "bittorrent"
      ]
    },
	{
      "type": "field",
      "outboundTag": "block",
      "network": "udp",
      "port": "443"
    },
	{
      "type": "field",
      "outboundTag": "Ai_Socks5_out",
      "ip": [
        "geoip:jp",
		"geoip:google"
      ]
    },  
    {
      "type": "field",
      "outboundTag": "IPv4_out",
      "domain": [
        "domain:cp.cloudflare.com",
        "domain:connectivitycheck.gstatic.com",
        "domain:www.gstatic.com",
        "domain:captive.apple.com",
		"domain:detectportal.firefox.com"
      ]
    },
	{
      "type": "field",
      "outboundTag": "IPv4_out",
      "ip": [
        "1.1.1.1"
      ]
    },  
    {
      "type": "field",
      "outboundTag": "IPv4_out",
      "domain": [
        "full:hotspot-detect.html"
      ]
    },
	{
      "type": "field",
      "outboundTag": "IPv4_out",
      "ip": [
        "geoip:ru"
      ]
    },
	{
      "type": "field",
      "outboundTag": "IPv4_out",
      "domain": [
		  "geosite:category-ru",
		  "geosite:category-ip-geo-detect"
	  ]
    },
	{
      "type": "field",
      "outboundTag": "Ai_Socks5_out",
      "domain": [
		  "geosite:category-ai-!cn",
		  "geosite:google-gemini"
	  ]
    },
    {
      "type": "field",
      "outboundTag": "Warp_Socks5_out",
      "network": "tcp"
    },
    {
      "type": "field",
      "outboundTag": "IPv4_out",
      "network": "tcp,udp"
    }
  ]
}
